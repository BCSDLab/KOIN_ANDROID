<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="118dp"
            android:layout_height="85dp"
            android:src="@drawable/ic_network_error" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/network_error_title"
            android:textColor="@color/rebrand_primary_500"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/network_error_subtitle"
            android:textAlignment="center"
            android:textColor="@color/rebrand_neutral_600"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/button_article_network_error_retry"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_network_error_retry_button"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_network_error_retry" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/network_error_retry"
                android:textColor="@color/rebrand_primary_500"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>
</layout>
