<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_main"
    app:startDestination="@id/bottom_navigation_home">

    <fragment
        android:id="@+id/bottom_navigation_home"
        android:name="in.koreatech.koin.ui.newmain.fragment.HomeFragment">
        <action
            android:id="@+id/action_home_to_notification"
            app:destination="@id/notification"
            app:enterAnim="@anim/slide_in_from_right_fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/slide_in_from_left_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/notification"
        android:name="in.koreatech.koin.ui.newmain.fragment.NotificationFragment" />

    <fragment
        android:id="@+id/bottom_navigation_category"
        android:name="in.koreatech.koin.ui.newmain.fragment.CategoryFragment" />

    <fragment
        android:id="@+id/bottom_navigation_article"
        android:name="in.koreatech.koin.ui.newmain.fragment.ArticleFragment">
        <action
            android:id="@+id/action_article_to_notification"
            app:destination="@id/notification"
            app:enterAnim="@anim/slide_in_from_right_fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/slide_in_from_left_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/bottom_navigation_profile"
        android:name="in.koreatech.koin.ui.newmain.fragment.ProfileFragment" />
</navigation>
